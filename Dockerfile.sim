# Simulator image: seeds the SQLite source systems and runs the replay clock.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci || npm install
COPY tsconfig.json ./
COPY schema ./schema
COPY src ./src
ENV SIM_DATA_DIR=/data
VOLUME /data
# Default: show clock status. Compose overrides the command.
ENTRYPOINT ["npx", "tsx", "src/sim.ts"]
CMD ["status"]
